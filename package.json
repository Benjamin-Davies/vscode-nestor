{
  "name": "vscode-nestor",
  "displayName": "Nestor C LSP",
  "description": "C LSP that takes a silly amount of shortcuts",
  "repository": "https://github.com/Benjamin-Davies/vscode-nestor",
  "publisher": "Benjamin-Davies",
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onLanguage:c"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Nestor",
      "properties": {
        "nestor.server.path": {
          "type": "string",
          "default": null,
          "description": "Path to a nestor binary. If unset, the latest release is downloaded automatically."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.146.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  }
}
